<Window x:Class="MCDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MCDM"
        Title="MC Download Manager" Width="1080" Height="620" MinWidth="780" MinHeight="420"
        Icon="app.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Margin="10,14,6,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,14">
                <Image Source="app.ico" Width="26" Height="26" />
                <TextBlock Text="MC Download Manager" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="Sidebar" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" SelectionChanged="Sidebar_Changed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SidebarEntry}">
                        <DockPanel Margin="{Binding Indent}" Height="22">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15" Width="22" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Secondary}" FontSize="12" Margin="8,0,4,0" />
                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content card -->
        <Border Grid.Column="1" Margin="0,8,8,8" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Margin="12,10,12,6" LastChildFill="False">
                    <Button x:Name="AddButton" Click="Add_Click" Padding="14,6" Margin="0,0,12,0" Height="34">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:S.AddDownload}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{x:Static local:S.Resume}" Click="Resume_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="{x:Static local:S.Pause}" Click="Pause_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="{x:Static local:S.Cancel}" Click="Cancel_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{x:Static local:S.Remove}" Click="Remove_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{x:Static local:S.ShowInFolder}" Click="Folder_Click" />

                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{x:Static local:S.Settings}" Click="Settings_Click" Margin="0" />
                    <Grid DockPanel.Dock="Right" Width="240" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center" Padding="32,6,8,6" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Margin="11,0,0,0" IsHitTestVisible="False" Style="{StaticResource Secondary}" />
                        <TextBlock x:Name="SearchHint" Text="{x:Static local:S.SearchHint}" Margin="34,0,0,0" IsHitTestVisible="False" Style="{StaticResource Secondary}" />
                    </Grid>
                </DockPanel>

                <!-- List -->
                <DataGrid x:Name="Grid" Grid.Row="1" Margin="4,0,4,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Extended" GridLinesVisibility="None" CanUserResizeRows="False" RowHeight="50"
                          BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                          MouseDoubleClick="Grid_DoubleClick" KeyDown="Grid_KeyDown">
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static local:S.ColName}" Width="*" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20" Width="30"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static local:S.ColSize}" Width="95" SortMemberPath="TotalBytes">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding SizeText}" VerticalAlignment="Center" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static local:S.ColStatus}" Width="220" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ErrorMessage}" />
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,5,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowProgress}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static local:S.ColSpeed}" Width="100" SortMemberPath="Speed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding SpeedText}" VerticalAlignment="Center" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static local:S.ColDate}" Width="140" SortMemberPath="CreatedAt">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat=g}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static local:S.Open}" Click="Open_Click" />
                            <MenuItem Header="{x:Static local:S.ShowInFolder}" Click="Folder_Click" />
                            <MenuItem Header="{x:Static local:S.Details}" Click="Details_Click" />
                            <MenuItem Header="{x:Static local:S.CopyLink}" Click="CopyLink_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:S.Resume}" Click="Resume_Click" />
                            <MenuItem Header="{x:Static local:S.Pause}" Click="Pause_Click" />
                            <MenuItem Header="{x:Static local:S.Cancel}" Click="Cancel_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:S.Remove}" Click="Remove_Click" />
                            <MenuItem Header="{x:Static local:S.RemoveAndDelete}" Click="RemoveDelete_Click" />
                            <Separator />
                            <MenuItem Header="{x:Static local:S.PauseAll}" Click="PauseAll_Click" />
                            <MenuItem Header="{x:Static local:S.ResumeAll}" Click="ResumeAll_Click" />
                            <MenuItem Header="{x:Static local:S.ClearFinished}" Click="ClearFinished_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="44" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Static local:S.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{x:Static local:S.EmptyHint}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <!-- Status bar -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="14,7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" Style="{StaticResource Secondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="ActiveText" Style="{StaticResource Secondary}" Margin="0,0,16,0" />
                            <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource Icons}" Style="{StaticResource Secondary}" Margin="0,0,6,0" />
                            <TextBlock x:Name="SpeedText" Style="{StaticResource Secondary}" />
                        </StackPanel>
                        <Ellipse x:Name="BridgeDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="BridgeText" Style="{StaticResource Secondary}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
