<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Fluent ThemeMode is still marked experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>MCDownloadManager</AssemblyName>
    <RootNamespace>MCDM</RootNamespace>
    <Product>MC Download Manager</Product>
    <Version>1.0.0</Version>
    <!-- File properties shown in Explorer; also helps antivirus reputation. -->
    <Company>azadkarakus</Company>
    <Description>MC Download Manager</Description>
    <AssemblyTitle>MC Download Manager</AssemblyTitle>
    <Copyright>Copyright (c) 2026 Mesut Çevik, azadkarakus. MIT License.</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Only ship framework resources for the UI languages we support. -->
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- Browser extension shipped next to the exe; copied to %LOCALAPPDATA% at startup for "Load unpacked". -->
    <None Include="..\Extension\**\*" LinkBase="Extension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
